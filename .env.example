# API Configuration
# Copy this file to .env.local and update with your actual values.

# Full API base URL (set in Vercel env vars for deployment).
# Defaults to http://localhost:8000/api/v1 in development when unset.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Gateway that Next.js proxies /api/* to (see next.config.mjs).
NEXT_PUBLIC_PROXY_TARGET=http://localhost:8000
